# Copy to .env.local (never commit .env.local) and fill in.

# The Apps Script web app URL (ends in /exec) and its shared secret.
# See Website/apps-script/README.md, steps 3 and 6. Server-only: never sent to the browser.
# Leave both empty in development to use the built-in mock backend.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# The public site address, used for links in metadata.
NEXT_PUBLIC_SITE_URL=https://www.strangersformary.org
